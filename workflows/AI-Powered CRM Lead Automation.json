      "parameters": {
        "jsCode": "let ai = {};\n\n// Safely parse AI response\ntry {\n  ai = JSON.parse($json.text);\n} catch (e) {\n  ai = {};\n}\n\n// Get normalized lead data\nconst lead = $items(\"Normalize Lead Data\")[0].json;\n\nreturn {\n  ...lead,\n\n  // AI outputs\n  intent: ai.intent || \"Review\",\n  priority: ai.priority || \"Low\",\n  lead_score: ai.lead_score ?? 0,\n  confidence: ai.confidence ?? 0.5,\n  summary: ai.summary || \"No summary generated\"\n};\n"
      },
